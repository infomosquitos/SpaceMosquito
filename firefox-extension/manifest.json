{
  "manifest_version": 3,
  "name": "Space Mosquito",
  "version": "0.5.0",
  "description": "Capture Confluence spaces for offline access",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "tabs",
    "contextualIdentities"
  ],
  "icons": {
    "16": "assets/icon-inactive-16.png",
    "32": "assets/icon-inactive-32.png",
    "48": "assets/icon-inactive-48.png",
    "128": "assets/icon-inactive-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "space@mosqui.to",
      "strict_min_version": "109.0"
    }
  },
  "host_permissions": [
    "<all_urls>",
    "http://localhost:8081/*",
    "http://localhost:8081/*",
    "http://127.0.0.1:8081/*",
    "http://127.0.0.1:8081/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; style-src 'self'; object-src 'self'; connect-src 'self' http://localhost:8081 http://localhost:8081 http://127.0.0.1:8081 http://127.0.0.1:8081 ws://localhost:8081 ws://127.0.0.1:8081"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Space Mosquito",
    "default_icon": {
      "16": "assets/icon-inactive-16.png",
      "32": "assets/icon-inactive-32.png"
    }
  }
}
