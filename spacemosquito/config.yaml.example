# Example config for local installs.
# Prefer: `spacemosquito init` (writes ~/.spacemosquito/config.yaml).
#
# Data directory: ~/.spacemosquito/  (override with SPACEMOSQUITO_DATA_DIR or --data-dir)

# Check GitHub for a newer release (at most once a day) and print how to
# upgrade. Set to false to turn off (or SPACEMOSQUITO_NO_UPDATE_CHECK=1).
# update_check: true

# serve also writes its log here (rotated at 10 MB, 3 old files kept).
# Relative to the data directory; "" = terminal only.
# log_file: logs/serve.log

database:
  driver: sqlite
  path: spacemosquito.db

storage:
  base_path: ~/.spacemosquito/saved
  # Page attachments (pptx, pdf, xlsx, …) larger than this are not downloaded
  # but linked to Confluence. Default 100; -1 = no limit.
  # max_attachment_mb: 100
  # Pause before each image/attachment download, to stay below Confluence's
  # rate limits (HTTP 429 also slows downloads down). Default 1500; -1 = none.
  # asset_delay_ms: 1500

session:
  # Generate: openssl rand -base64 32
  encryption_key: ""
  file_path: ~/.spacemosquito/session.enc

# browser:
#   path: /usr/bin/chromium   # optional; CHROMIUM_PATH env overrides this

embedder:
  model: nomic-embed-text

mcp:
  port: 56403
  host: "127.0.0.1"
  # session_timeout: ignored (legacy; MCP is stateless Streamable HTTP)
  expose_internal_ids: false

cron:
  full_crawl:
    enabled: false
    interval: "24h"
    max_duration: "4h"
    spaces:
      - "https://company.atlassian.net/wiki/spaces/PROJ"
  incremental:
    enabled: false
    interval: "2h"
    max_duration: "30m"
    detection: "dom"
    spaces:
      - "https://company.atlassian.net/wiki/spaces/PROJ"
